{
  "ELASTICSEARCH_ENVS": {
    "test": {
      "host": "http://your-es-host:9200",
      "user": "elastic",
      "password": "******",
      "nginx_env": "test-nmore-or-nginx-*"
    }
  },
  "S3": {
    "test": {
      "aws_access_key_id": "******",
      "aws_secret_access_key": "******",
      "bucket_name": "your-bucket-name"
    }
  },
  "ENV": "test",
  "domain": {
    "test": "https://test-qa-mercury.example.com",
    "prod": "https://prod-qa-mercury.example.com"
  },
  "qa": {
    "prod": {
      "host": "your-mysql-host",
      "user": "your_db_user",
      "password": "******",
      "database": "qa",
      "port": 3306
    },
    "test": {
      "host": "your-mysql-host",
      "user": "your_db_user",
      "password": "******",
      "database": "qa",
      "port": 3306
    }
  },
  "ldap": {
    "server_uri": "ldap://your-ldap-host:389",
    "base_dn": "dc=example,dc=com",
    "bind_dn": "CN=Service Account,OU=Service Accounts,DC=example,DC=com",
    "bind_password": "******"
  },
  "flashcat": "https://api.flashcat.cloud/event/push/alert/standard?integration_key=******"
}
